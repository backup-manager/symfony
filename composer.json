{
    "name": "backup-manager/symfony",
    "description": "Database backup manager bundle for Symfony: back up and restore MySQL and PostgreSQL to S3, Google Cloud Storage, Dropbox, FTP, SFTP, WebDAV and more.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "database",
        "backup",
        "symfony",
        "bundle",
        "mysql",
        "postgresql",
        "s3",
        "flysystem"
    ],
    "authors": [
        {
            "name": "Tobias Nyholm",
            "email": "tobias.nyholm@gmail.com"
        },
        {
            "name": "Luiz Henrique Gomes Palácio",
            "email": "lhpalacio@outlook.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "backup-manager/backup-manager": "^4.1",
        "league/flysystem": "^3.35.3",
        "nyholm/dsn": "^2.0",
        "symfony/config": "^6.4.50 || ^7.4.23 || ^8.1.11",
        "symfony/console": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/filesystem": "^6.4.50 || ^7.4.23 || ^8.1.11",
        "symfony/framework-bundle": "^6.4.49 || ^7.4.23 || ^8.1.11",
        "symfony/http-kernel": "^6.4.50 || ^7.4.23 || ^8.1.11",
        "symfony/process": "^6.4.33 || ^7.4.5 || ^8.1",
        "symfony/yaml": "^6.4.50 || ^7.4.23 || ^8.1.11"
    },
    "require-dev": {
        "matthiasnoback/symfony-config-test": "^5.1 || ^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^5.1 || ^6.0",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8"
    },
    "suggest": {
        "league/flysystem-async-aws-s3": "AsyncAwsS3 storage type",
        "league/flysystem-aws-s3-v3": "AwsS3 storage type",
        "league/flysystem-ftp": "Ftp storage type",
        "league/flysystem-google-cloud-storage": "Gcs storage type",
        "league/flysystem-sftp-v3": "Sftp storage type",
        "league/flysystem-webdav": "Webdav storage type",
        "spatie/flysystem-dropbox": "Dropbox storage type"
    },
    "autoload": {
        "psr-4": {
            "BM\\BackupManagerBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
